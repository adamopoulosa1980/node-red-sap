  },
  {
    "id": "7a0e000000000131",
    "type": "function",
    "z": "7a0e0000000000a0",
    "name": "The new travel",
    "func": "const id = flow.get('travelId');\nif (!id) {\n    node.warn('Press \"2. New travel in two weeks\" first');\n    return null;\n}\n// a bound action is called on the entity; the node sends its ETag as If-Match\nmsg.bindingPath = \"Travel('\" + id + \"')\";\nreturn msg;",
    "outputs": 1,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 400,
    "y": 220,
    "wires": [["7a0e000000000132"]]
  },
