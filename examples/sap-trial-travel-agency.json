  },
  {
    "id": "7a0e000000000121",
    "type": "function",
    "z": "7a0e0000000000a0",
    "name": "Travel request",
    "func": "// a week's trip starting in two weeks, for an agency and a customer of the demo data\nconst day = (n) => new Date(Date.now() + n * 86400000).toISOString().slice(0, 10);\nmsg.payload = {\n    AgencyID: '70041',\n    CustomerID: '594',\n    BeginDate: day(14),\n    EndDate: day(21),\n    BookingFee: 25,\n    CurrencyCode: 'EUR',\n    Memo: 'Created from Node-RED'\n};\nreturn msg;",
    "outputs": 1,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 400,
    "y": 160,
    "wires": [["7a0e000000000122"]]
  },
  {
    "id": "7a0e000000000122",
    "type": "sap-odata",
    "z": "7a0e0000000000a0",
    "name": "Create travel",
    "connection": "7a0e0000000000c0",
    "service": "/sap/opu/odata4/dmo/api_travel_u_v4/srvd_a2x/dmo/travel_u/0001",
    "version": "auto",
    "operation": "create",
    "entitySet": "Travel",
    "useMetadata": true,
    "convertDates": true,
    "stripMetadata": true,
    "x": 580,
    "y": 160,
    "wires": [["7a0e000000000123"]]
  },
  {
    "id": "7a0e000000000123",
    "type": "function",
    "z": "7a0e0000000000a0",
    "name": "Remember travel id",
    "func": "flow.set('travelId', msg.payload.TravelID);\nnode.status({ fill: 'green', shape: 'dot', text: 'travel ' + msg.payload.TravelID });\nreturn msg;",
    "outputs": 1,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 770,
    "y": 160,
    "wires": [["7a0e000000000190"]]
  },
  {
    "id": "7a0e000000000130",
    "type": "inject",
    "z": "7a0e0000000000a0",
    "name": "3. Book it",
    "props": [],
    "repeat": "",
