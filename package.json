{
  "name": "node-red-contrib-sap-odata",
  "version": "0.1.0",
  "description": "Node-RED nodes for SAP Gateway OData V2 / V4: CRUD, function imports, actions, $batch, $metadata, catalog, CSRF and ETag handling",
  "keywords": [
    "node-red",
    "sap",
    "odata",
    "s4hana",
    "gateway",
    "btp",
    "proxy",
    "ntlm",
    "kerberos",
    "oauth2"
  ],
  "license": "MIT",
  "main": "lib/client.js",
  "files": [
    "lib",
    "nodes",
    "examples",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "node-red": {
    "version": ">=3.0.0",
    "nodes": {
      "sap-connection": "nodes/sap-connection.js",
      "sap-odata": "nodes/sap-odata.js"
    }
  },
  "scripts": {
    "test": "node --test --experimental-test-coverage --test-coverage-include=lib/** --test-coverage-include=nodes/** --test-coverage-lines=100 --test-coverage-branches=100 --test-coverage-functions=100 \"test/**/*.test.js\"",
    "test:live": "node test/live/sandbox-v2.js && node test/live/sandbox-v4.js",
    "test:trial": "node test/live/local-trial.js",
    "coverage:lcov": "node --test --experimental-test-coverage --test-coverage-include=lib/** --test-coverage-include=nodes/** --test-reporter=lcov --test-reporter-destination=coverage/lcov.info \"test/**/*.test.js\"",
    "coverage:report": "node tools/uncovered.js"
  },
  "dependencies": {
    "fast-xml-parser": "^5.12.1",
    "httpntlm": "^1.8.14",
    "https-proxy-agent": "^9.1.0"
  },
  "devDependencies": {
    "@sap-cloud-sdk/connectivity": "^4.10.0",
    "node-red": "^4.0.9",
    "node-red-node-test-helper": "^0.3.4"
  },
  "peerDependencies": {
    "kerberos": ">=6",
    "@sap-cloud-sdk/connectivity": ">=4"
  },
  "peerDependenciesMeta": {
    "kerberos": {
      "optional": true
    },
    "@sap-cloud-sdk/connectivity": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adamopoulosa1980/node-red-sap.git"
  },
  "homepage": "https://github.com/adamopoulosa1980/node-red-sap#readme",
  "bugs": {
    "url": "https://github.com/adamopoulosa1980/node-red-sap/issues"
  }
}
